{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": [
      "node",
      "express",
      "multer"
    ],
    "paths": {
      "src/*": ["src/*"],
      "@libs/config": ["../../libs/shared/config/src/index.ts"],
      "@libs/schema": ["../../libs/shared/schema/src/index.ts"],
      "@libs/axios": ["../../libs/shared/axios/src/index.ts"],
      "@libs/mongodb": ["../../libs/shared/mongodb/src/index.ts"],
      "@libs/redis": ["../../libs/shared/redis/src/index.ts"],
      "@libs/minio": ["../../libs/shared/minio/src/index.ts"],
      "@libs/cloundinary": ["../../libs/shared/cloundinary/src/index.ts"],
      "@libs/auth": ["../../libs/shared/auth/src/index.ts"],
      "@libs/logger": ["../../libs/shared/logger/src/index.ts"],
      "@libs/core": ["../../libs/shared/core/src/index.ts"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
  }
}