{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "src/*": ["src/*"],
      "@libs/schema": ["../../libs/shared/schema/src/index.ts"],
      "@libs/axios": ["../../libs/node/axios/src/index.ts"],
      "@libs/redis": ["../../libs/node/redis/src/index.ts"],
      "@libs/mongodb": ["../../libs/node/mongodb/src/index.ts"],
      "@libs/auth": ["../../libs/node/auth/src/index.ts"],
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
  }
}