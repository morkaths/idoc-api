# App
NODE_ENV=development
PORT=5004
LOG_LEVEL=info

# URLs
BASE_URL=http://localhost:5004
API_URL=http://localhost:8000/api
FRONTEND_URL=http://localhost:3000

# Allowed Origins (for CORS and CSP)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000,http://localhost:5004

# Auth / Keys
API_KEY=your_api_key_here

# Database
MONGODB_URI=mongodb://localhost:27017/borrow

# Email (SMTP) Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM="iDoc Library" <idoc.workspace@gmail.com>