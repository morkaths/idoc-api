{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2022",
    "customConditions": [
      "@idoc-api/source"
    ],
    "baseUrl": ".",
    "paths": {
      "@idoc-api/schema": [
        "libs/shared/schema/src/index.ts"
      ],
      "@idoc-api/auth": [
        "libs/shared/auth/src/index.ts"
      ],
      "@idoc-api/mongodb": [
        "libs/shared/mongodb/src/index.ts"
      ],
      "@idoc-api/redis": [
        "libs/shared/redis/src/index.ts"
      ],
      "@idoc-api/minio": [
        "libs/shared/minio/src/index.ts"
      ],
      "@idoc-api/logger": [
        "libs/shared/logger/src/index.ts"
      ],
      "@idoc-api/cloundinary": [
        "libs/shared/cloundinary/src/index.ts"
      ]
    }
  }
}