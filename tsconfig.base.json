{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": [
      "@idoc-api/source"
    ],
    "baseUrl": ".",
    "paths": {
      "@idoc/node/auth": [
        "libs/node/auth/src/index.ts"
      ],
      "@idoc/node/mongodb": [
        "libs/node/mongodb/src/index.ts"
      ],
      "@idoc/node/node-redis": [
        "libs/node/redis/src/index.ts"
      ],
      "@idoc/schema": [
        "libs/shared/schema/src/index.ts"
      ],
      "@idoc-api/minio": [
        "libs/node/minio/src/index.ts"
      ]
    }
  }
}