{
  "name": "common-excel",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/common/excel/src",
  "targets": {
    "build": {
      "executor": "@jnxplus/nx-boot-maven:run-task",
      "outputs": [
        "{projectRoot}/target"
      ],
      "options": {
        "task": "install -DskipTests=true"
      }
    },
    "lint": {
      "executor": "@jnxplus/nx-boot-maven:lint",
      "options": {
        "linter": "checkstyle"
      }
    },
    "test": {
      "executor": "@jnxplus/nx-boot-maven:run-task",
      "options": {
        "task": "test"
      }
    }
  },
  "tags": []
}
