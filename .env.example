# =========================================
# app
# =========================================
    # name
APP_NAME=idoc

    # mode
NODE_ENV=development

    # url
API_URL=http://localhost:8000/api

    # web
WEB_URL=http://localhost:3000

    # logLevel
LOG_LEVEL=info

    # allowedOrigins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:8000,
http://localhost:8080,
http://localhost:8085,
http://localhost:5000,
http://localhost:5001,
http://localhost:5002,
http://localhost:5003,
http://localhost:5004"

